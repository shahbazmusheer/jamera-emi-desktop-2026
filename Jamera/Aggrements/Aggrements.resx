  <data name="customSqlQuery1.Sql" xml:space="preserve">
    <value>select TOP 5000 stores.area_code as 'Area Code',stores.name as 'Area',aggrements.date  as 'Date',aggrements.id as 'Code',aggrements.ref_no as 'Ref.No',accounts.id as 'Cust.Code',accounts.name as 'Customer',guardians.name as 'Guarantor',aggrements.current_balance as 'Balance',items.id as 'Item.Code',items.name as 'Item',
sale_items.advance_rate as 'Advance',sale_items.emi_price as 'Monthly EMI',
sale_items.sale_rate as 'Rate',sold_qty as 'Qty',sale_items.net_total as 'Total' 
from ((((dbo.aggrements aggrements left join dbo.accounts accounts on (accounts.id = aggrements.customer_id))  inner join dbo.stores stores on (stores.id = aggrements.store_id)) left join dbo.accounts guardians on (guardians.id = aggrements.guardian_id))) left join sale_items on aggrements.id=sale_items.agreement_id left join items on sale_items.item_id=items.id ORDER BY aggrements.id DESC</value>
  </data>
  <data name="customSqlQuery2.Sql" xml:space="preserve">
    <value>select "stores"."area_code" as 'Area Code',"accounts"."id" as 'Code', "accounts"."name" as 'Name',       "accounts"."father_name" as 'Father Name', 
 "accounts"."phone" as 'Office Phone', "accounts"."home_phone" as 'Home Phone',"accounts"."balance" as 'Balance'
  from ("dbo"."accounts" "accounts"
  inner join "dbo"."stores" "stores"
       on ("stores"."id" = "accounts"."store_id")) WHERE accounts.account_group_id='1002'

</value>
  </data>
  <data name="customSqlQuery4.Sql" xml:space="preserve">
    <value>SELECT items.id as 'Code',items.name as 'Item',models.name as 'Model',items.packing as 'Packing',i_u.name as 'Unit',COALESCE(SUM(y.items_stock_in - y.items_stock_out),0) as 'Stock' from items left join item_manufacturers  i_m on i_m.id=items.manufacturer_id left join item_groups  i_g on i_g.id=items.group_id left join item_categories as i_g_s on i_g_s.id=items.category_id left join item_units as i_u on i_u.id=items.unit_id left join purchase_items as y on items.id=y.item_id left join item_models as models on items.model_id=models.id group by items.id ,items.name,i_u.name,items.packing,items.purchase_rate,items.sale_rate ,items.location,items.unit_cost,items.gst ,items.sale_discount,items.is_active,items.reorder_level ,items.manufacturer_date,items.expiry_date,i_m.name,i_g.name ,i_g_s.name,models.name;
</value>
  </data>
