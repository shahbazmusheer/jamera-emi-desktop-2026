  <data name="customSqlQuery5.Sql" xml:space="preserve">
    <value>SELECT TOP 1000 e_s.pay_date as 'Paid Date',ac.id as 'Emp.Code',ac.name as 'Emp.Name',e_s.basic_salary'Basic Salary',e_s.bonus as 'Bonus',e_s.commission as 'Commission',e_s.advance_payment as 'Advance Payment',e_s.other_deductions as 'Other Duductons',e_s.net_salary as 'Net Salary',e_s.remarks as 'Remarks' FROM employees_salaries e_s left join accounts as ac on e_s.account_id=ac.id</value>
  </data>
  <data name="customSqlQuery6.Sql" xml:space="preserve">
    <value>select "accounts"."id" as 'Code', "accounts"."name" as 'Name',
"stores"."area_code" as 'Area Code',
       "roles"."name" as 'Role',"accounts"."advance_limit" as 'Advance Limit', "accounts"."balance" as 'Balance'
  from (("dbo"."accounts" "accounts"
  left join "dbo"."stores" "stores"
       on ("stores"."id" = "accounts"."store_id"))
  left join "dbo"."roles" "roles"
       on ("roles"."id" = "accounts"."role_id")) WHERE account_group_id='1009'

</value>
  </data>
