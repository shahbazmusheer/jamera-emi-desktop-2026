  <data name="customSqlQuery2.Sql" xml:space="preserve">
    <value>select "accounts"."id" as 'Code', "accounts"."name" as 'Name',
       "stores"."area_code" as 'Area Code', "accounts"."phone" as 'Phone',
       "accounts"."balance" as 'Balance'
  from ("dbo"."accounts" "accounts"
  inner join "dbo"."stores" "stores"
       on ("stores"."id" = "accounts"."store_id")) WHERE accounts.role_id='6'
</value>
