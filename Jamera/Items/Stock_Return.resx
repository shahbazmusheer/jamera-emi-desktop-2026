  <data name="customSqlQuery2.Sql" xml:space="preserve">
    <value>SELECT rank() over(order by sti.item_id,items.name,models.name,sti.sale_rate) as 'Sr.No',sti.item_id as 'Code',items.name as 'Item',models.name as 'Model',sti.sale_rate as 'Sale Rate',i_u.name as 'Unit',items.packing as 'Packing',SUM(sti.stock_in - (sti.sold_out + sti.returned + sti.transfered)) as 'Stock' FROM stock_transaction_items as sti left join items on sti.item_id=items.id left join item_units as i_u on items.unit_id=i_u.id left join item_models as models on items.model_id=models.id WHERE ((sti.stock_in - (sti.sold_out + sti.returned + sti.transfered) ) &gt; 0) GROUP BY sti.item_id,items.name,sti.sale_rate,i_u.name,items.packing,models.name</value>
  </data>
