  <data name="customSqlQuery22.Sql" xml:space="preserve">
    <value>select "stores"."area_code" as 'Area Code',"accounts"."id" as 'Code', "accounts"."name" as 'Name',       "accounts"."father_name" as 'Father Name',"accounts"."id_card_no" as 'CNIC',  
 "accounts"."phone" as 'Office Phone', "accounts"."home_phone" as 'Home Phone',"accounts"."balance" as 'Balance'
  from ("dbo"."accounts" "accounts"
  left join "dbo"."stores" "stores"
       on ("stores"."id" = "accounts"."store_id")) WHERE accounts.account_group_id='1002'</value>
  </data>
