  <data name="customSqlQuery1.Sql" xml:space="preserve">
    <value>SELECT TOP 1000 cv.date as 'Date',cv.id as 'Code',stores.id as 'Store.Code',stores.name as 'Store',stores.area_code as 'Area Code',cv.field_worker as 'Field Worker',cv.area_name as 'Area Name',cv.vehicle_number as 'Vehicle No',cv.voucher_balance as 'Voucher Balance' FROM cash_vouchers as cv left join stores on cv.store_id=stores.id</value>
