  <data name="customSqlQuery2.Sql" xml:space="preserve">
    <value>select "accounts"."id" as 'Code', "accounts"."name" as 'Name',       "accounts"."father_name" as 'Father Name', 
 "accounts"."phone" as 'Office Phone', "accounts"."home_phone" as 'Home Phone',stores.id as 'Store.Code',"stores"."area_code" as 'Area Code',"accounts"."balance" as 'Balance'
  from ("dbo"."accounts" "accounts"
  left join "dbo"."stores" "stores"
       on ("stores"."id" = "accounts"."store_id")) WHERE accounts.account_group_id='1002'

</value>
  </data>
