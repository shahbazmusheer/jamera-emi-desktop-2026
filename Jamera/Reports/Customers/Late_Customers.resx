  <data name="customSqlQuery1.Sql" xml:space="preserve">
    <value>SELECT 
    st.name as [Store Name],
    ag.ref_no as [Ref.No],
    cust.name as [Customer],
    cust.father_name as [Father],
    cust.phone as [Office Phone],
    cust.home_phone as [Home Phone],
    cust.id_card_no as [CNIC],
    ag.rest_emi as [Monthly EMI], 
    ag.current_balance as [Total Overdue],
    
    LateInfo.LateMonths as [Late Months Count],
    LateInfo.SumLateAmount as [Late Overdue Amount],
    LateInfo.Duration as [Duration]
    
FROM aggrements ag
INNER JOIN accounts cust ON ag.customer_id = cust.id
INNER JOIN stores st ON ag.store_id = st.id
CROSS APPLY (
    SELECT 
        COUNT(ad.id) as LateMonths,
        ISNULL(SUM(ad.emi_amount - ad.paid_amount), 0) as SumLateAmount,
        FORMAT(MIN(CONVERT(DATETIME, ad.emi_date, 103)), 'MMM-yy') + ' - ' + 
        FORMAT(MAX(CONVERT(DATETIME, ad.emi_date, 103)), 'MMM-yy') as Duration
    FROM aggrement_dues ad
    WHERE ad.aggrement_id = ag.id
      AND ad.is_return_fixed &lt; 1
      AND CONVERT(DATETIME, ad.emi_date, 103) &lt;= GETDATE()
      
      AND CONVERT(DATETIME, ad.emi_date, 103) &gt; ISNULL(
          (SELECT MAX(CONVERT(DATETIME, inner_ad.emi_date, 103))
           FROM aggrement_dues inner_ad
           WHERE inner_ad.aggrement_id = ag.id 
             AND inner_ad.paid_amount &gt; 0 
             AND inner_ad.is_return_fixed &lt; 1
             AND CONVERT(DATETIME, inner_ad.emi_date, 103) &lt;= GETDATE()),
          DATEADD(DAY, -1, (SELECT MIN(CONVERT(DATETIME, m.emi_date, 103)) 
                            FROM aggrement_dues m WHERE m.aggrement_id = ag.id))
      )
) AS LateInfo

WHERE ag.status = 'In-Progress'  AND LateInfo.LateMonths &gt; 3 

ORDER BY 
    st.name ASC, 
    -- 1. Sort by Year (Middle part of Ref_No)
    CAST(PARSENAME(REPLACE(ag.ref_no, '-', '.'), 2) AS INT) ASC,
    -- 2. Sort by Serial Number (Last part of Ref_No) as Number
    CAST(PARSENAME(REPLACE(ag.ref_no, '-', '.'), 1) AS INT) ASC;</value>
  </data>
  <data name="customSqlQuery2.Sql" xml:space="preserve">
    <value>select stores.area_code as 'Area Code',accounts.id as 'Code', accounts.name as 'Name',accounts.father_name as 'Father Name',accounts.age as 'Age',accounts.phone as 'Office Phone',accounts.home_phone as 'Home Phone',accounts.cost as 'Cast', accounts.profession as 'Profession',accounts.id_card_no as 'CNIC',accounts.business_address as 'Business Address',accounts.home_address as 'Home Address',accounts.balance from (dbo.accounts accounts left join dbo.stores stores  on (stores.id = accounts.store_id)) WHERE accounts.account_group_id='1002'</value>
  </data>
