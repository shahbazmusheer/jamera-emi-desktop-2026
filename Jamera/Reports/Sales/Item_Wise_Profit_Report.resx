  <data name="customSqlQuery1.Sql" xml:space="preserve">
    <value>SELECT 
    items.id as 'Item.Code',
    items.name as 'Item',
    -- 1. Net Quantity
    CONVERT(decimal(37,2), (SUM(sale_items.sold_qty) - SUM(sale_items.returned_qty))) as 'Qty',
    
    -- 2. Average Unit Cost (Purchase Rate / Packing)
    CONVERT(decimal(37,2), 
        SUM((purchase_items.purchase_rate / items.packing) * (sale_items.sold_qty - sale_items.returned_qty)) / 
        NULLIF(SUM(sale_items.sold_qty - sale_items.returned_qty), 0)
    ) as 'Unit Cost(Per Item)',
    
    -- 3. Average Sale Rate
    CONVERT(decimal(37,2), 
        SUM(sale_items.sale_rate * (sale_items.sold_qty - sale_items.returned_qty)) / 
        NULLIF(SUM(sale_items.sold_qty - sale_items.returned_qty), 0)
    ) as 'Sale Rate(Per Item)',
    
    -- 4. TOTAL VALUE (Gross Sale Amount)
    CONVERT(decimal(37,2), 
        SUM(sale_items.sale_rate * (sale_items.sold_qty - sale_items.returned_qty))
    ) as 'Total Value',
    
    -- 5. TOTAL MARGIN (Total Value - Total Cost)
    CONVERT(decimal(37,2), 
        SUM(sale_items.sale_rate * (sale_items.sold_qty - sale_items.returned_qty)) - 
        SUM((purchase_items.purchase_rate / items.packing) * (sale_items.sold_qty - sale_items.returned_qty))
    ) as 'Total Margin'

FROM sale_items 
LEFT JOIN purchase_items ON sale_items.purchase_item_id = purchase_items.id 
LEFT JOIN items ON items.id = sale_items.item_id 
LEFT JOIN aggrements ON sale_items.agreement_id = aggrements.id  
WHERE sale_items.item_id IN (SELECT id FROM items) 
GROUP BY items.id, items.name, items.list_order
-- Only show items that actually have a positive net sale
HAVING (SUM(sale_items.sold_qty) - SUM(sale_items.returned_qty)) &gt; 0
ORDER BY items.list_order ASC</value>
  </data>
