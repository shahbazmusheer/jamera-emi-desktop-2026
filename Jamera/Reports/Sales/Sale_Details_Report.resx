  <data name="customSqlQuery1.Sql" xml:space="preserve">
    <value>select stores.name 'Area', aggrements.id as 'Code',convert(varchar(11),aggrements.date,105) as 'Date',
aggrements.ref_no as 'Ref.No', aggrements.emi_no as 'EMI.No',


-- '[Agg.Code: '+convert(varchar,aggrements.id)+']  -  [Date:'+
-- convert(varchar(11),aggrements.date,105) + ']  -  [Ref.No:'+
-- convert(varchar,aggrements.ref_no)+']  -  [EMI.No:'+
-- convert(varchar,aggrements.emi_no)+']' as 'Agg.Details',

accounts.name as 'Customer', aggrements.advance_amount as 'Advance',
aggrements.current_balance as 'Agg.Balance', accounts.balance as 'Cust.Balance',
-- '[Customer:'+accounts.name +']  -  [Agr.Advance: ' +
--convert(varchar,aggrements.advance_amount)+']  -  [Agr.Balance: ' 
-- +convert(varchar,aggrements.current_balance)+']  -  [Customer.Bal: '
-- +convert(varchar,aggrements.current_balance)+']' as 'Sale Details',
items.id as 'Item.Code',items.name as 'Item',
sale_items.sale_rate as 'Rate',sold_qty as 'Sold', 
returned_quantity as 'Returned',sale_items.net_total as 'Total' 
from JAMERA_EMI.DBO.aggrements 
left join JAMERA_EMI.DBO.accounts on accounts.id = aggrements.customer_id 
inner join JAMERA_EMI.DBO.stores on (stores.id = aggrements.store_id) 
left join JAMERA_EMI.DBO.sale_items on aggrements.id=sale_items.agreement_id 
left join JAMERA_EMI.DBO.items on JAMERA_EMI.DBO.sale_items.item_id=items.id 
WHERE stores.id='501'
ORDER BY aggrements.ref_no ASC</value>
  </data>
