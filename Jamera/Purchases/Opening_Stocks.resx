  <data name="customSqlQuery2.Sql" xml:space="preserve">
    <value>SELECT items.id as 'Code',items.name as 'Item',items.packing as 'Packing',i_u.name as 'Unit',COALESCE(SUM(y.items_stock_in - y.items_stock_out),0) as 'Stock' from items left join item_manufacturers  i_m on i_m.id=items.manufacturer_id left join item_groups  i_g on i_g.id=items.group_id left join item_categories as i_g_s on i_g_s.id=items.category_id left join item_units as i_u on i_u.id=items.unit_id left join purchase_items as y on items.id=y.item_id group by items.id ,items.name,i_u.name,items.packing,items.purchase_rate,items.sale_rate ,items.location,items.unit_cost,items.gst ,items.sale_discount,items.is_active,items.reorder_level ,items.manufacturer_date,items.expiry_date,i_m.name,i_g.name ,i_g_s.name;


</value>
  </data>
